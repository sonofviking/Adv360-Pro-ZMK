#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      /* ── Real Programmer Dvorak inverted keys ───────────────────────
         Each key outputs the Dvorak char unshifted, and the char in
         parentheses when shift is held.                      */

      mm_dlr:  mm_dlr  { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N4)>;      morph = <&kp LS(GRAVE)>;  mods = <(MOD_LSFT | MOD_RSFT)>; }; /* $ (~) */
      mm_plus: mm_plus { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(EQUAL)>;    morph = <&kp N1>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* + (1) */
      mm_lb:   mm_lb   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(LBKT)>;     morph = <&kp N2>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* [ (2) */
      mm_lc:   mm_lc   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(LBKT)>;     morph = <&kp N3>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* { (3) */
      mm_lp:   mm_lp   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N9)>;       morph = <&kp N4>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* ( (4) */
      mm_amp:  mm_amp  { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N7)>;       morph = <&kp N5>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* & (5) */
      mm_eq:   mm_eq   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp EQUAL>;       morph = <&kp N6>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* = (6) */
      mm_rp:   mm_rp   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N0)>;       morph = <&kp N7>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* ) (7) */
      mm_rc:   mm_rc   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(RBKT)>;     morph = <&kp N8>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* } (8) */
      mm_rb:   mm_rb   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(RBKT)>;     morph = <&kp N9>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* ] (9) */
      mm_star: mm_star { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N8)>;       morph = <&kp N0>;         mods = <(MOD_LSFT | MOD_RSFT)>; }; /* * (0) */
      mm_excl: mm_excl { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N1)>;       morph = <&kp LS(N5)>;     mods = <(MOD_LSFT | MOD_RSFT)>; }; /* ! (%) */
      mm_bar:  mm_bar  { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(BSLH)>;     morph = <&kp GRAVE>;      mods = <(MOD_LSFT | MOD_RSFT)>; }; /* | (`) */
      mm_at:   mm_at   { compatible = "zmk,mod-morph"; #binding-cells = <0>; binding = <&kp LS(N2)>;       morph = <&kp LS(N6)>;     mods = <(MOD_LSFT | MOD_RSFT)>; }; /* @ (^) */
    };

  keymap {
    compatible = "zmk,keymap";

    /* ── Layer 0: Base — Real Programmer Dvorak ───────────────────────
       Number row follows the RPD xkb map; letters follow Dvorak.
       Left key next to 5: hold → mouse layer. Key next to 6: mod layer. */

    default_layer {
      display-name = "Base";
      bindings = <
        &mm_bar  &mm_plus &mm_lb  &mm_lc  &mm_lp   &mm_amp &mo 1                                                            &mo 3 &mm_eq  &mm_rp  &mm_rc   &mm_rb   &mm_star &mm_excl
        &kp TAB  &kp SEMI &kp COMMA &kp DOT &kp P   &kp Y   &none                                                            &none &kp F   &kp G   &kp C    &kp R    &kp L    &kp BSLH
        &kp ESC  &kp A    &kp O   &kp E    &kp U    &kp I   &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp D   &kp H   &kp T    &kp N    &kp S    &kp MINUS
        &kp LSHFT &kp SQT  &kp Q   &kp J    &kp K    &kp X                                 &kp HOME &kp PG_UP                           &kp B  &kp M   &kp W    &kp V    &kp Z    &kp RSHFT
        &mo 2    &mm_dlr &kp CAPS &kp LEFT &kp RIGHT              &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN &kp FSLH &mm_at &mo 2
      >;
    };

    /* ── Layer 1: Mouse / Nav (hold the key left of "5") ───────────────
       Right hand home row:  click | ← ↓ ↑ → | click
       Row below:            scroll ← ↓ ↑ → | middle click
       Left number row:      Bluetooth profile select / clear
       Left Esc row:         output selection (USB / BLE)             */

    mouse {
      display-name = "Mouse";
      bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &trans                                                        &trans &trans   &trans    &trans    &trans    &trans   &trans
        &trans       &trans      &trans      &trans      &trans      &trans      &none                                                            &none &trans   &trans    &trans    &trans    &trans   &trans
        &out OUT_USB &out OUT_BLE &trans    &trans      &trans      &trans      &none           &trans &trans &trans &trans                    &none &mkp LCLK &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &mkp RCLK
        &trans       &trans      &trans      &trans      &trans      &trans                                &trans &trans                                 &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &mkp MCLK &trans
        &trans       &trans      &trans      &trans      &trans                   &trans &trans  &trans &trans &trans &trans                            &kp UP &kp DOWN &kp LEFT &kp RIGHT &trans
      >;
    };

    /* ── Layer 2: Fn (unchanged from stock) ─────────────────────────── */

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &none                                           &trans &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    /* ── Layer 3: Mod (BT select, bootloader, RGB) — stock layout ───── */

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                        &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
